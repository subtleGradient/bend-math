<?xml version="1.0" encoding="UTF-8"?>
<!-- Content MathML encodes equals(add(1, 1), 2), not a proof. -->
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <apply>
    <eq/>
    <apply>
      <plus/>
      <cn type="integer">1</cn>
      <cn type="integer">1</cn>
    </apply>
    <cn type="integer">2</cn>
  </apply>
</math>
